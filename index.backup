      <!-- PARTE 3: COMO O XP FUNCIONA -->
      <div class="xp-formula reveal">
        <div class="xp-formula-item"><span class="xp-formula-icon">&#128283;</span><strong>Quantum 5:</strong> todo XP vira múltiplo de 5.</div>
        <div class="xp-formula-item"><span class="xp-formula-icon">&#128293;</span><strong>Buffs:</strong> 2× / 5× / 10× nos ganhos.</div>
        <div class="xp-formula-item"><span class="xp-formula-icon">&#128165;</span><strong>Morte:</strong> perde 25% do XP do nível.</div>
        <div class="xp-formula-item"><span class="xp-formula-icon">&#128081;</span><strong>Realm Master 5:</strong> 3× XP do assentamento.</div>
      </div>
    </div>
