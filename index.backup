      <!-- CALLOUT: CHEFES -->
      <div class="xp-boss-callout reveal">
        <div class="xp-boss-icon">&#128081;</div>
        <div class="xp-boss-body">
          <span class="xp-boss-tag">XP Premium</span>
          <h4 class="xp-boss-title">Chefes & Mini-chefes</h4>

          <div class="xp-boss-block">
            <div class="xp-boss-label">&#128081; Boss</div>
