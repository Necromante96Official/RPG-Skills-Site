  <section class="section section-alt" id="xp-detail">
    <div class="section-glow-line"></div>
    <div class="section-texture"></div>
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label" data-i18n="xp-detail.label">Fontes de XP Detalhadas</div>
        <h2 class="section-title" data-i18n="xp-detail.title">Tudo Sobre <span class="text-green">XP</span></h2>
        <p class="section-subtitle" style="margin:0 auto;" data-i18n="xp-detail.subtitle">Cada ação gera XP de forma diferente. Compreenda todas as fontes para otimizar sua progressão.</p>
