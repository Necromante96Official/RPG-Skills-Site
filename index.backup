  <!-- ========== PASSIVES ========== -->
  <section class="section">
    <div class="section-glow-line"></div>
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label" data-i18n="passives.label">Passivas e Habilidades</div>
        <h2 class="section-title" data-i18n="passives.title">19 <span class="text-green">Passivas</span> Desbloqueáveis</h2>
        <p class="section-subtitle" style="margin:0 auto;" data-i18n="passives.subtitle">Cada classe oferece passivas exclusivas ao investir pontos. Algumas requerem nível máximo para desbloquear.</p>
      </div>

      <div class="grid-3 reveal" style="margin-top:var(--space-xl);">
        <!-- Eagle Eye -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-combat);">&#128065; Olho de Águia</h4>
          <p class="passive-effect">Mostra barras de vida e radar de inimigos/animais próximos permanentemente.</p>
          <p class="passive-req">Requisito: Mestre Atirador >= 1 ponto</p>
        </div>
        <!-- Deus do Dano -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-combat);">&#9876; Deus do Dano</h4>
          <p class="passive-effect">+50% de dano total. Requer TODAS as 4 classes de combate no nível 5.</p>
          <p class="passive-req">Requisito: Guerra+Atirador+Magia+Invocador = nível 5</p>
        </div>
        <!-- Minerador de Veios -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-utility);">&#9935; Minerador de Veios</h4>
          <p class="passive-effect">Minera veios inteiros de minério automaticamente. Modo avançado encadeia blocos do mesmo tipo.</p>
          <p class="passive-req">Requisito: Mestre das Cavernas >= 1 ponto</p>
        </div>
        <!-- Ruína Escura -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-utility);">&#128161; Ruína Escura</h4>
          <p class="passive-effect">Aumenta alcance de trinkets luminosos de 250 para 350. Funciona com trinket equipado.</p>
          <p class="passive-req">Requisito: Mestre das Cavernas >= 1 ponto</p>
        </div>
        <!-- Escritor Imortal -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-utility);">&#10024; Escritor Imortal</h4>
          <p class="passive-effect">Scrolls de encantamento não são consumidos ao usar.</p>
          <p class="passive-req">Requisito: Mestre Arcano >= 1 ponto</p>
        </div>
        <!-- Golpe de Ouro -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-utility);">&#129689; Golpe de Ouro</h4>
          <p class="passive-effect">Gera ouro a cada hit: 10/pt, máximo 50 gold no nível 5. Respeita Coin Pouch.</p>
          <p class="passive-req">Requisito: Mestre da Riqueza >= 1 ponto</p>
        </div>
        <!-- Reflexo do Pescador -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-utility);">&#127907; Reflexo do Pescador</h4>
          <p class="passive-effect">Pesca AFK: pega peixe e recoloca isca automaticamente no mesmo local.</p>
          <p class="passive-req">Requisito: Mestre do Mar >= 1 ponto</p>
        </div>
        <!-- Bênção Vital -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-defense);">&#10084; Bênção Vital</h4>
          <p class="passive-effect">HP extra por segundo enquanto poção de vida está ativa.</p>
          <p class="passive-req">Requisito: Mestre da Vitalidade >= 1 ponto</p>
        </div>
        <!-- Proteção Colossal -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-defense);">&#128737; Proteção Colossal</h4>
          <p class="passive-effect">Invulnerabilidade temporária ao ser atingido. Dura 2-10s. Cooldown 30s.</p>
          <p class="passive-req">Requisito: Mestre Colossal >= 1 ponto</p>
        </div>
        <!-- Graça de Hermes -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-defense);">&#128167; Graça de Hermes</h4>
          <p class="passive-effect">Nível 4: Imunidade a lentidão. Nível 5: Remove e bloqueia todos debuffs.</p>
          <p class="passive-req">Requisito: Mestre da Resistência Elemental >= 4 pontos</p>
        </div>
        <!-- Poção Automática -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-defense);">&#129514; Poção Automática</h4>
          <p class="passive-effect">Usa poções de vida automaticamente quando HP <= 50%.</p>
          <p class="passive-req">Requisito: Mestre da Alquimia = nível 5</p>
        </div>
        <!-- Sempre Barriga Cheia -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-defense);">&#127830; Sempre Barriga Cheia</h4>
          <p class="passive-effect">Come automaticamente quando fome cai abaixo de 95%.</p>
          <p class="passive-req">Requisito: Mestre Gourmet = nível 5</p>
        </div>
        <!-- Colheita de Rancho -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-utility);">&#128037; Colheita de Rancho</h4>
          <p class="passive-effect">Animais de rancho mortos na zona de criação dropam 5x mais itens.</p>
          <p class="passive-req">Requisito: Mestre do Rancho = nível 5</p>
        </div>
        <!-- Aura de Liderança -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-settler);">&#128081; Aura de Liderança</h4>
          <p class="passive-effect">Colonos ganham +15% dano, HP, resistência e velocidade. Com personalidade alinhada: 22.5%.</p>
          <p class="passive-req">Requisito: Mestre dos Reinos = nível 5</p>
        </div>
        <!-- Líder do Assentamento -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-settler);">&#127969; Líder do Assentamento</h4>
          <p class="passive-effect">Força QoL Sem Rival nos colonos, bloqueia greves de humor, 3x XP de assentamento.</p>
          <p class="passive-req">Requisito: Mestre dos Reinos = nível 5</p>
        </div>
        <!-- Administração Rica -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-settler);">&#128176; Administração Rica</h4>
          <p class="passive-effect">Colonos com 6+ personalidades ganham +50% XP de assentamento e recrutamento.</p>
          <p class="passive-req">Requisito: Informacional (ativado com 6+ personalidades)</p>
        </div>
        <!-- Engenharia Defensiva -->
        <div class="card passive-card">
          <h4 style="color:var(--cat-utility);">&#128483; Engenharia Defensiva</h4>
          <p class="passive-effect">Armadilhas de assentamento aplicam sangramento em inimigos.</p>
          <p class="passive-req">Requisito: Mestre das Armadilhas = nível 5</p>
        </div>
        <!-- Mestre das Classes -->
        <div class="card passive-card">
          <h4 style="color:var(--gold);">&#9733; Mestre das Classes</h4>
          <p class="passive-effect">Todas as classes habilitadas no nível 5: partículas brancas + trail de movimento + aura luminosa.</p>
          <p class="passive-req">Requisito: TODAS as classes habilitadas = nível 5</p>
        </div>
        <!-- Especialista em Incursions -->
        <div class="card passive-card">
          <h4 style="color:var(--red);">&#9760; Especialista em Incursions</h4>
          <p class="passive-effect">Incursions de alto tier usam as zonas de XP mais fortes disponíveis.</p>
          <p class="passive-req">Requisito: Informacional (baseado em progressão)</p>
        </div>
      </div>
    </div>
  </section>

